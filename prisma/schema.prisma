datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Customer {
  id                 Int                @id @default(autoincrement())
  name               String
  type               String             @default("PJ")
  document           String?
  phone              String?
  
  // Campos PF
  nomeSocial         String?
  dataNascimento     String?
  rg                 String?
  rgEmissor          String?
  rgDataExp          String?
  nomePai            String?
  nomeMae            String?
  nacionalidade      String?
  naturalidade       String?
  estadoCivil        String?
  sexo               String?
  profissao          String?
  
  // Campos PJ
  nomeFantasia       String?
  responsavel        String?
  cpfResponsavel     String?
  dataFundacao       String?
  inscricaoMunicipal String?
  
  // Campo Comum (PF e PJ)
  inscricaoEstadual  String?
  
  isHidden           Boolean            @default(false)
  locations  CustomerLocation[]
  contacts   CustomerContact[]
  occurrences Occurrence[]
  receivables AccountsReceivable[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model CustomerContact {
  id         Int      @id @default(autoincrement())
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId Int
  name       String
  type       String   @default("Telefone")
  value      String
}

model CustomerLocation {
  id             Int            @id @default(autoincrement())
  customer       Customer       @relation(fields: [customerId], references: [id])
  customerId     Int
  street         String
  neighborhood   String
  city           String
  state          String
  cep            String
  numero         String?
  complemento    String?
  pontoReferencia String?
  codigoMun      String?
  condominium    Condominium?   @relation(fields: [condominiumId], references: [id])
  condominiumId  Int?
  contact        String?        // Legacy / Primary contact
  contacts       LocationContact[]
  occurrences    Occurrence[]
  workLogs       EmployeeWorkLog[]
}

model Condominium {
  id        Int                @id @default(autoincrement())
  name      String
  locations CustomerLocation[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model LocationContact {
  id           Int              @id @default(autoincrement())
  location     CustomerLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId   Int
  name         String
  phone        String?
}

model ServiceType {
  id          Int    @id @default(autoincrement())
  name        String // ex: Manutenção, Limpeza
  occurrences Occurrence[]
}

model PaymentMethod {
  id          Int    @id @default(autoincrement())
  name        String // ex: Pix, Boleto, Cartão
  occurrences Occurrence[]
  receivables AccountsReceivable[]
}

model Occurrence {
  id                Int       @id @default(autoincrement())
  number            String?
  customer          Customer  @relation(fields: [customerId], references: [id])
  customerId        Int
  location          CustomerLocation @relation(fields: [locationId], references: [id])
  locationId        Int
  serviceType       ServiceType @relation(fields: [serviceTypeId], references: [id])
  serviceTypeId     Int
  status            String    // Orçamento, Agendada, Em execução, Concluída, Adiada, Cancelada
  scheduled_date    DateTime
  scheduled_time    String?
  completed_at      DateTime?
  total_amount      Float
  paymentMethod     PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  paymentMethodId   Int?
  payment_status    String?   // Pendente, Recebido, Parcial, Atrasado, Cancelado
  notes             String?
  technicianNotes   String?
  anvisaExpiry      DateTime?
  
  assignments       OccurrenceAssignment[]
  visits            OccurrenceVisit[]
  receivables       AccountsReceivable[]
  workLogs          EmployeeWorkLog[]
  
  isHidden          Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model OccurrenceAssignment {
  id             Int        @id @default(autoincrement())
  occurrence     Occurrence @relation(fields: [occurrenceId], references: [id])
  occurrenceId   Int
  employee       Employee   @relation(fields: [employeeId], references: [id])
  employeeId     Int
  role           String?    // Papel na Ocorrência
}

model OccurrenceVisit {
  id             Int        @id @default(autoincrement())
  occurrence     Occurrence @relation(fields: [occurrenceId], references: [id])
  occurrenceId   Int
  scheduled_at   DateTime?
  started_at     DateTime?
  finished_at    DateTime?
  status         String?
  notes          String?    // Aqui pode ser "Reforço", "Retorno" etc
}

model CashPoint {
  id             Int                  @id @default(autoincrement())
  name           String
  type           String               @default("Caixa Físico") // Caixa Físico, Conta Bancária, Carteira Digital, Cofre, Outro
  initialBalance Float                @default(0)
  description    String?
  ativo          Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  
  receivables    AccountsReceivable[]
  payables       AccountsPayable[]
}

model RevenueCategory {
  id          Int                  @id @default(autoincrement())
  name        String
  receivables AccountsReceivable[]
}

model AccountsReceivable {
  id              Int              @id @default(autoincrement())
  description     String?
  occurrence      Occurrence?      @relation(fields: [occurrenceId], references: [id])
  occurrenceId    Int?
  customer        Customer?        @relation(fields: [clientId], references: [id])
  clientId        Int?
  category        RevenueCategory? @relation(fields: [categoryId], references: [id])
  categoryId      Int?
  amount          Float
  due_date        DateTime
  payment_date    DateTime?
  status          String
  paymentMethod   PaymentMethod?   @relation(fields: [paymentMethodId], references: [id])
  paymentMethodId Int?
  cashPoint       CashPoint?       @relation(fields: [cashPointId], references: [id])
  cashPointId     Int?
}

model ExpenseCategory {
  id       Int    @id @default(autoincrement())
  name     String
  payables AccountsPayable[]
}

model Vehicle {
  id               Int               @id @default(autoincrement())
  plate            String            @unique
  model            String?
  brand            String?
  year             String?
  color            String?
  renavam          String?
  chassi           String?
  tipo             String?           @default("Utilitário") // Utilitário, Furgão, Moto, Passeio, Caminhão
  combustivel      String?           @default("Flex") // Flex, Gasolina, Diesel, GNV, Elétrico
  quilometragem    Float?            @default(0)
  status           String            @default("Ativo") // Ativo, Em Manutenção, Inativo, Reserva
  responsavel      String?
  seguradora       String?
  apoliceSeguro    String?
  vencimentoSeguro DateTime?
  vencimentoIpva   DateTime?
  observacoes      String?
  ativo            Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  payables         AccountsPayable[]
}

model Blacklist {
  id                   Int       @id @default(autoincrement())
  nome                 String
  documento            String?   // CPF ou CNPJ
  tipo                 String    @default("Inadimplência") // Inadimplência, Fraude, Risco de Segurança, Conflito Jurídico, Endereço de Risco, Outro
  motivo               String
  telefone             String?
  email                String?
  bloquearAgendamento  Boolean   @default(true)
  bloquearVenda        Boolean   @default(true)
  cadastradoPor        String?   @default("Administrador")
  ativo                Boolean   @default(true) // se o bloqueio está ativo
  dataDesbloqueio      DateTime?
  motivoDesbloqueio    String?
  observacoes          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model AccountsPayable {
  id             Int              @id @default(autoincrement())
  description    String
  category       ExpenseCategory  @relation(fields: [categoryId], references: [id])
  categoryId     Int
  amount         Float
  due_date       DateTime
  payment_date   DateTime?
  status         String
  vehicle        Vehicle?         @relation(fields: [vehicleId], references: [id])
  vehicleId      Int?
  responsible    String?
  cashPoint      CashPoint?       @relation(fields: [cashPointId], references: [id])
  cashPointId    Int?
}

model Employee {
  id               Int     @id @default(autoincrement())
  name             String
  cargo            String?
  phone            String?
  status           String?
  
  last_lat         Float?
  last_lng         Float?
  last_location_at DateTime?
  
  user             User?
  
  assignments      OccurrenceAssignment[]
  workLogs         EmployeeWorkLog[]
}

model User {
  id         Int       @id @default(autoincrement())
  username   String?   @unique
  email      String    @unique
  password   String
  role       String    // Administrador, Financeiro, Gestor, Operador
  ativo      Boolean   @default(true)
  employee   Employee? @relation(fields: [employeeId], references: [id])
  employeeId Int?      @unique
  
  logs       SystemLog[]
}

model EmployeeWorkLog {
  id               Int          @id @default(autoincrement())
  employee         Employee     @relation(fields: [employeeId], references: [id])
  employeeId       Int
  date             DateTime
  occurrence       Occurrence?  @relation(fields: [occurrenceId], references: [id])
  occurrenceId     Int?
  location         CustomerLocation? @relation(fields: [locationId], references: [id])
  locationId       Int?
  entrada          String?
  saida            String?
  horas_trabalhadas Float?
  horas_extras     Float?
  tipo_diaria      String?
  valor            Float?
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  user      User?    @relation(fields: [userId], references: [id])
  userId    Int?
  action    String   // ex: "CRIOU", "EDITOU", "EXCLUIU", "STATUS"
  resource  String   // ex: "Ocorrência", "Cliente", "Financeiro"
  details   String?  // Detalhes da ação
  ipAddress String?  // IP de quem realizou a ação
  createdAt DateTime @default(now())
}

model ContractTemplate {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  category    String   @default("Geral")
  content     String   @db.Text
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Company {
  id                 Int       @id @default(autoincrement())
  razaoSocial        String
  nomeFantasia       String?
  cnpj               String?
  inscricaoEstadual  String?
  inscricaoMunicipal String?

  // Contato
  telefone           String?
  whatsapp           String?
  email              String?
  website            String?

  // Endereço
  cep                String?
  logradouro         String?
  numero             String?
  complemento        String?
  bairro             String?
  cidade             String?
  estado             String?

  // Dados Técnicos, Regulatórios e Sanitários
  responsavelLegal    String?
  cpfResponsavelLegal String?
  responsavelTecnico String?
  conselhoClasse     String?
  alvaraSanitario    String?
  licencaAmbiental   String?
  registroConselho   String?

  // Financeiro / Pagamentos
  pixChave           String?
  pixTipo            String?

  // Identidade Visual
  logoUrl            String?   @db.Text
  assinaturaUrl      String?   @db.Text

  isMatriz           Boolean   @default(false)
  isAtiva            Boolean   @default(true)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model StockItem {
  id               Int             @id @default(autoincrement())
  nome             String
  codigo           String?         // SKU ou Código interno
  categoria        String          @default("Químicos / Inseticidas") // Químicos / Inseticidas, Raticidas, Equipamentos, EPIs, Acessórios e Armadilhas, Outros
  principioAtivo   String?         // Ex: Deltametrina, Brodifacoum
  grupoQuimico     String?         // Ex: Piretroide, Cumarínico
  registroMS       String?         // Registro ANVISA / MS / MAPA
  unidade          String          @default("UN") // UN, L, mL, KG, G, CX, GL
  estoqueMinimo    Float           @default(0) // Alerta de reposição geral
  precoCustoPadrao Float?          // Preço sugerido de custo
  precoVendaPadrao Float?          // Preço sugerido de venda/comodato
  fornecedorPadrao String?
  observacoes      String?         @db.Text
  ativo            Boolean         @default(true)
  balances         StockBalance[]
  movements        StockMovement[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Warehouse {
  id                   Int             @id @default(autoincrement())
  nome                 String          // Ex: "Almoxarifado Central", "Viatura 01 - Fiorino", "Depósito de Químicos"
  codigo               String?         // Ex: "ALM-01", "VT-01"
  tipo                 String          @default("Fixo") // Fixo (Almoxarifado/Depósito), Móvel (Viatura Técnica), Quarentena
  responsavel          String?         // Nome do técnico/responsável
  localizacao          String?         // Endereço ou descrição
  descricao            String?         @db.Text
  ativo                Boolean         @default(true)
  balances             StockBalance[]
  originMovements      StockMovement[] @relation("WarehouseOrigin")
  destinationMovements StockMovement[] @relation("WarehouseDestination")
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model StockBalance {
  id          Int       @id @default(autoincrement())
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  stockItemId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  warehouseId Int
  quantidade  Float     @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([stockItemId, warehouseId])
}

model StockMovement {
  id                     Int        @id @default(autoincrement())
  stockItem              StockItem  @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  stockItemId            Int
  tipo                   String     // COMPRA, VENDA, SAIDA_SERVICO, COMODATO, TRANSFERENCIA, DEVOLUCAO, AJUSTE, DESCARTE
  quantidade             Float
  
  warehouseOriginId      Int?
  warehouseOrigin        Warehouse? @relation("WarehouseOrigin", fields: [warehouseOriginId], references: [id])
  
  warehouseDestinationId Int?
  warehouseDestination   Warehouse? @relation("WarehouseDestination", fields: [warehouseDestinationId], references: [id])
  
  valorUnitario          Float?
  valorTotal             Float?
  
  lote                   String?
  dataValidade           DateTime?
  
  clienteNome            String?    // Para Venda, Comodato ou Saída de Serviço
  fornecedorNome         String?    // Para Compra
  documentoRef           String?    // NF, OS, Contrato
  motivo                 String?
  responsavel            String?    // Quem lançou a movimentação
  
  createdAt              DateTime   @default(now())
}



